# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=jdbc:postgresql://localhost:5432/healthtrackme
DATABASE_USERNAME=healthtrackme
DATABASE_PASSWORD=change-me

POSTGRES_DB=healthtrackme
POSTGRES_USER=healthtrackme
POSTGRES_PASSWORD=change-me

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me
# AUTH_ENABLED=true                 # set false to disable JWT enforcement (dev only)
# JWT_EXPIRATION_SECONDS=2592000    # token lifetime in seconds (default 30 days)

# ── Google Sign-In ──────────────────────────────────────────────────────────
GOOGLE_OAUTH_ALLOWED_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# ── Email summary (optional): server emails the health summary to the logged-in user ──
APP_MAIL_ENABLED=false
# Sender shown on the email (for Brevo this MUST be your verified sender address):
APP_MAIL_FROM=HealthTrackMe <healthtrackme@gmail.com>
# Option A (recommended): Brevo — verify one sender, email any recipient over HTTPS.
BREVO_API_KEY=                       # from https://brevo.com (free 300/day)
# Option B: Resend — HTTPS, but arbitrary recipients need a verified domain.
# RESEND_API_KEY=
# Option C (local dev): Gmail SMTP — often blocked on PaaS hosts.
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# ── AI (optional): Groq (Llama 3) Health Detective insights & Q&A ────────────
GROQ_API_KEY=                        # from https://console.groq.com — free, no card needed
# GROQ_MODEL=llama-3.3-70b-versatile
