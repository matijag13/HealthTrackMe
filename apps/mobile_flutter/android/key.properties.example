## Copy this file to key.properties and fill in the real values.
## Keep the real key.properties and the .jks file out of version control.

storePassword=YOUR_STORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=healthtrackme
# Path is relative to the android/ directory. Example: storeFile=../../../healthtrackme.jks
storeFile=../../../healthtrackme.jks

