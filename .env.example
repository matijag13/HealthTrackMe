# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=jdbc:postgresql://localhost:5432/healthtrackme
DATABASE_USERNAME=healthtrackme
DATABASE_PASSWORD=change-me

POSTGRES_DB=healthtrackme
POSTGRES_USER=healthtrackme
POSTGRES_PASSWORD=change-me

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me
# AUTH_ENABLED=true                 # set false to disable JWT enforcement (dev only)
# JWT_EXPIRATION_SECONDS=2592000    # token lifetime in seconds (default 30 days)

# ── Google Sign-In ──────────────────────────────────────────────────────────
GOOGLE_OAUTH_ALLOWED_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# ── Email summary (optional): server emails the health summary to the user ────
APP_MAIL_ENABLED=false
# Option A (recommended for cloud/Railway — sends over HTTPS, no SMTP egress needed):
RESEND_API_KEY=                      # from https://resend.com (free tier)
# APP_MAIL_FROM=HealthTrackMe <onboarding@resend.dev>   # default; needs a verified domain to send to anyone
# Option B (local dev): Gmail SMTP — often blocked on PaaS hosts.
# SMTP_USERNAME=                     # a Gmail address
# SMTP_PASSWORD=                     # a Gmail App Password (requires 2FA enabled)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# ── AI (optional): Claude-powered Health Detective insights & Q&A ────────────
ANTHROPIC_API_KEY=                   # leave blank to fall back to rule-based insights
# ANTHROPIC_MODEL=claude-haiku-4-5
